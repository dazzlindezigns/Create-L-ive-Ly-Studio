# ── Frontend (exposed to the browser — anon key only!) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://orders.example.com

# ── Server only (Vercel → Settings → Environment Variables) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Square — Developer Dashboard → your app → Credentials / Locations / Webhooks
SQUARE_SECRET_KEY=            # access token (sandbox or production)
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox    # sandbox | production
SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://orders.example.com/api/square-webhook   # only if it differs from VITE_APP_URL + /api/square-webhook

# Resend — domain must be verified before EMAIL_FROM works
RESEND_API_KEY=
EMAIL_FROM="[HER BUSINESS NAME] <orders@example.com>"
MAKER_EMAIL=owner@example.com

# Return address for shipping labels
MAKER_STREET=
MAKER_CITY=
MAKER_STATE=
MAKER_ZIP=
MAKER_PHONE=
EASYPOST_API_KEY=

# Web push — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI price estimates
ANTHROPIC_API_KEY=
