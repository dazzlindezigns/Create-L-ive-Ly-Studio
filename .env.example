# ── Frontend (exposed to the browser — anon key only!) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://createlivelystudio.vercel.app

# ── Server only (Vercel → Settings → Environment Variables) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Square — Developer Dashboard → your app → Credentials / Locations / Webhooks
SQUARE_SECRET_KEY=            # access token (sandbox or production)
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox    # sandbox | production
SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://orders.example.com/api/square-webhook   # only if it differs from VITE_APP_URL + /api/square-webhook

# Resend — domain must be verified before EMAIL_FROM works
RESEND_API_KEY=
EMAIL_FROM="Create(L)ive(Ly) Studio <orders@createlivelyinc.com>"
MAKER_EMAIL=owner@example.com   # new-order alerts — use an inbox she actually reads (e.g. Gmail)

# Customer replies → app + her inbox (Resend receiving)
REPLY_DOMAIN=createlivelyinc.com        # the domain set up for receiving in Resend
REPLY_FORWARD_TO=                        # where a copy of each reply goes (defaults to MAKER_EMAIL); must NOT be on REPLY_DOMAIN
RESEND_WEBHOOK_SECRET=                   # Resend → Webhooks → https://<app>/api/resend-webhook (email.received) → signing secret

# Web push — generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Claude — AI price estimates + listing writer (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Gemini — listing photo generator (aistudio.google.com → Get API key; needs billing enabled)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # optional override when Google releases a newer image model
