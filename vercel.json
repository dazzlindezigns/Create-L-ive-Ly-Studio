{
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/product-page?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[action].js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/review-reminders",
      "schedule": "0 15 * * *"
    }
  ]
}
